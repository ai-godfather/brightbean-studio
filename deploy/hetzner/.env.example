# Deployment identity
BRIGHTBEAN_IMAGE_TAG=local
SHOPAUTH_NETWORK=shopauth-production_default

# Django
SECRET_KEY=replace-with-a-long-random-value
ENCRYPTION_KEY_SALT=replace-with-an-independent-long-random-value
DEBUG=false
ALLOWED_HOSTS=studio.shopauth.cloud
APP_URL=https://studio.shopauth.cloud
MCP_PUBLIC_BASE_URL=https://studio.shopauth.cloud
MCP_OAUTH_ISSUER_URL=https://studio.shopauth.cloud

# PostgreSQL (use URL-safe values because Compose builds DATABASE_URL from these)
POSTGRES_DB=brightbean
POSTGRES_USER=brightbean
POSTGRES_PASSWORD=replace-with-a-url-safe-random-value

# Hetzner Object Storage (a dedicated bucket is required for large MCP uploads)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://nbg1.your-objectstorage.com
S3_REGION_NAME=nbg1
S3_BUCKET_NAME=brightbean-studio-ai-godfather
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CUSTOM_DOMAIN=

# Self-hosted defaults
EMAIL_BACKEND_TYPE=console
DEFAULT_FROM_EMAIL=noreply@shopauth.cloud
SENTRY_DSN=
UNSPLASH_ACCESS_KEY=

# Instagram Direct (Professional Business/Creator account)
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=

# Optional login and other publishing providers
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

# Optional hosted Intelligence integration (disabled while blank)
INTELLIGENCE_INTERNAL_URL=
INTELLIGENCE_PUBLIC_URL=
STUDIO_DEPLOYMENT_ID=
STUDIO_SHARED_SECRET=
STUDIO_BASE_URL=
